<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="HuwWenCapture.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="CaptureHotkey" Type="System.String" Scope="User">
      <Value Profile="(Default)">Alt+Shift+Q</Value>
    </Setting>
    <Setting Name="CaptureDirectory" Type="System.String" Scope="User">
      <Value Profile="(Default)">SPECIAL_PICTURES</Value>
    </Setting>
    <Setting Name="StartMinimized" Type="System.Boolean" Scope="User">
      <Value Profile="(Default)">False</Value>
    </Setting>
  </Settings>
</SettingsFile>